    "eval:compare": "tsx scripts/eval-compare.ts",
    "check:contrast": "node scripts/check-contrast.js",
    "check:docs": "node scripts/check-docs.js",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:contrast && npm run check:docs && npm run design:lint && npm run check:design-tokens",
    "design:lint": "designmd lint docs/visual-design.md",
    "check:design-tokens": "node scripts/check-design-tokens.js",
    "test:a11y": "playwright test"
