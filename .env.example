# ローカル開発用。これを .env.local にコピーして値を入れる（.env.local はコミットしない）
# Vercel には同じ名前で設定する。一覧の正は src/lib/env.ts の ENV_NAMES

# LINE Developers > Messaging API チャネル
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Anthropic Console
ANTHROPIC_API_KEY=

# Supabase > Project Settings > API（service role key はサーバー専用。ブラウザに出さない）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend（担当者へのメール通知。Week 3 から）
RESEND_API_KEY=

# 1日の API 費用の上限（USD）。超えたら「混み合っています」で止める
DAILY_COST_LIMIT_USD=5
