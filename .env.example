# ローカル開発用。これを .env.local にコピーして値を入れる（.env.local はコミットしない）
# Vercel には同じ名前で設定する。一覧の正は src/lib/env.ts の ENV_NAMES

# LINE Developers > Messaging API チャネル
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Anthropic Console
ANTHROPIC_API_KEY=

# Supabase > Project Settings > API Keys（secret key はサーバー専用。ブラウザに出さない）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 管理画面のログイン用（sb_publishable_…）。RLS が効くので、担当者・閲覧用の権限はここで決まる
SUPABASE_PUBLISHABLE_KEY=

# Resend（担当者へのメール通知）。RESEND_API_KEY と STAFF_NOTIFY_EMAIL の両方があるときだけ送る（無ければログだけ）
RESEND_API_KEY=
STAFF_NOTIFY_EMAIL=
# 差出人。独自ドメインを検証するまでは空のまま（Resend の検証用アドレスで、Resend に登録したメールアドレスにだけ届く）
NOTIFY_FROM_EMAIL=
# 通知メールに載せる管理画面の URL の起点。空なら Vercel の本番 URL（ローカルでは http://localhost:3000）
APP_BASE_URL=

# 1日の API 費用の上限（USD）。超えたら「混み合っています」で止める
DAILY_COST_LIMIT_USD=5

# ローカル開発専用: 1 にすると管理画面をインメモリのデモデータで開く（ログイン不要・LINE には送らない）。本番では無視される
ADMIN_PREVIEW=

# 公開デモ: 1 にすると、あいさつと引き継ぎ・仮受付の文に「デモのため担当者からの連絡はありません」を足す（本番の Vercel だけ 1）
DEMO_MODE=
# Vercel Cron（/api/cron/daily。デモ会話の作り直しと会話ログの90日削除）の認証。長いランダムな文字列にする。Vercel に入れると Cron が Bearer で付けて呼ぶ
CRON_SECRET=

# 公開デモの閲覧用アカウント（role = viewer。読み取りだけ・見られるのは架空のデモ会話だけ）。DEMO_MODE=1 で両方あるときだけ、
# ログイン画面に載せ、毎朝の Cron（/api/cron/daily）でこのアカウントのパスワードをこの値に戻す（誰かが変えても締め出されない）。
# 先に npm run admin:user -- --email=<DEMO_VIEWER_EMAIL> --role=viewer でアカウントを作る。パスワードは 8 文字以上・公開してよい値にする
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
